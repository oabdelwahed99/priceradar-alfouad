# MongoDB Atlas connection string (required)
MONGODB_URI=
# Database name used when the URI does not include one
MONGODB_DB=price_radar

# Public base URL of the app, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Workspace that product data is stored under
DEFAULT_WORKSPACE_ID=default

# Sign-in. Account ID eslam_dermaelle is a member. Account ID admin can capture content and refresh prices.
AUTH_PASSWORD=
ADMIN_PASSWORD=
# Long random string used to sign the session cookie
AUTH_SECRET=

# Optional scraper tuning
# SCRAPER_CONCURRENCY=3          # 1-5 URLs scraped simultaneously
# SCRAPER_TIMEOUT_MS=30000       # navigation timeout per URL
# SCRAPER_DOMAIN_DELAY_MS=1500   # minimum delay between requests to the same domain

# OpenAI (optional — required only for Content & SEO draft generation)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
